{
  "name": "printshare-web",
  "version": "1.0.0",
  "private": true,
  "description": "PrintShare Web: upload from any device, print through a USB printer attached to a Windows bridge.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts prisma/seed.ts scripts/cleanup.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outdir=dist --out-extension:.js=.cjs --entry-names=[name]",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "prisma generate && node scripts/copy-pdfjs.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pg": "8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "swr": "2.3.6",
    "tailwind-merge": "3.3.1",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
