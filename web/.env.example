# ---------------------------------------------------------------------------
# PrintShare Web – environment variables
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://printshare:CHANGE_ME@localhost:5432/printshare?schema=public"

# Public base URL users and the Windows bridge use to reach this server.
# Must be https:// in production (the bridge refuses plain http except for localhost).
APP_URL="http://localhost:3000"

# Long random secret for signed document URLs and bridge download tokens (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SIGNING_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# HTTP server binding.
PORT=3000
HOST=0.0.0.0

# Set to true only when running behind a reverse proxy / tunnel that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# File storage (originals + converted PDFs). Not web-served; access is via signed URLs.
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=25
# Uploaded documents and converted PDFs are deleted automatically after this many hours.
DOCUMENT_TTL_HOURS=24

# LibreOffice for DOCX/XLSX/PPTX -> PDF. Leave empty to auto-detect common install paths.
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=""
LIBREOFFICE_TIMEOUT_MS=90000

# Malware scanning (ClamAV clamd over TCP). Leave CLAMAV_HOST empty to disable.
CLAMAV_HOST=""
CLAMAV_PORT=3310
# When true, uploads are rejected if the scanner is not configured or unreachable.
MALWARE_SCAN_REQUIRED=false

# Seed: this account is created/promoted to ADMIN by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_NAME="PrintShare Admin"

# --- Vercel / serverless (see docs/VERCEL.md) ---------------------------------
# Non-pooled connection used only for `prisma migrate deploy` during Vercel production builds.
DIRECT_URL=""
# Set automatically when a Vercel Blob store is connected; switches storage to private Blob.
BLOB_READ_WRITE_TOKEN=""
# STORAGE_DRIVER="local"            # or "vercel-blob" (auto-detected)
# REALTIME_TRANSPORT="websocket"    # or "poll" (auto on Vercel)
CRON_SECRET=""
# Gotenberg (LibreOffice over HTTP) for Office files where LibreOffice can't run, e.g. Vercel.
GOTENBERG_URL=""
GOTENBERG_AUTH=""
# Link shown on Printers -> Connect computer.
BRIDGE_DOWNLOAD_URL=""
